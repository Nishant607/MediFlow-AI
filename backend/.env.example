SECRET_KEY=django-insecure-change-this-secret-key-for-production-environment
DEBUG=True
DATABASE_URL=postgres://hospital_user:hospital_pass@db:5432/hospital_db
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0
# Get a free API key at https://console.groq.com — required for the AI Patient Assistant (Phase 6) to work
GROQ_API_KEY=your-groq-api-key-here
# Optional. Get a free DSN at sentry.io if you want error tracking. Leave blank to disable (default, zero cost).
SENTRY_DSN=
# Optional — leave all blank to keep free console-only email (prints to logs).
# Fill in to send real emails via SMTP (e.g. Gmail app password, or a free tier like Brevo).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
